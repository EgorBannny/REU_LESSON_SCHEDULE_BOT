# Обязателен всегда (и для Docker, и для локального запуска)
BOT_TOKEN=

# для локальной разработки переопределил docker compose, для разработки dev.yml переопределяет главный docker-compose
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml


# Всё, что ниже, нужно ТОЛЬКО при запуске без Docker (uv run bot.py / uv run poller.py
# напрямую на хосте). В docker-compose.yml DATABASE_URL для контейнеров задан жёстко
# (адрес контейнера db), значение отсюда для докера не используется; POLL_INTERVAL_MINUTES
# и NOTIFY_* в докере тоже необязательны — есть значения по умолчанию (5 / 60 / 2).

# DATABASE_URL=postgresql://schedule:schedule@localhost:5432/schedule
# POLL_INTERVAL_MINUTES=5
# NOTIFY_INTERVAL_SECONDS=60
# NOTIFY_LOOKBACK_DAYS=2
